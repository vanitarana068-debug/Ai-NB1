# Public, client-side values — safe to commit (protected by row level security).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side secret for the FAQ assistant. Put this in .env.local (gitignored),
# NOT in .env — .env is committed. Without it the assistant still answers from
# the built-in FAQ, it just can't handle free-form phrasing.
ANTHROPIC_API_KEY=sk-ant-your-key

# Server-side secret for recording the Claude bill (supabase/migrations/0005).
# The service-role key bypasses row level security — keep it in .env.local only,
# NEVER commit it, and never expose it to the browser. Without it the assistant
# still works; it just doesn't record what each call costs. SUPABASE_URL is
# optional here — it falls back to VITE_SUPABASE_URL above.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay payments. The Key ID is publishable and goes in .env (committed) as
# VITE_RAZORPAY_KEY_ID so the browser can open Checkout. The Key Secret and
# webhook secret are server-only — keep them in .env.local, never commit them.
# Leave everything empty to keep the demo checkout (no real charge). Charges are
# in INR. Use TEST keys until you're ready to go live.
VITE_RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Brevo (Sendinblue) — order-confirmation email. API key from the Brevo
# dashboard → SMTP & API → API Keys; server-side only, keep it in .env.local.
# BREVO_SENDER_EMAIL must be a verified sender in Brevo. Empty → email no-ops.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=orders@your-domain.com
BREVO_SENDER_NAME=Northbridge
