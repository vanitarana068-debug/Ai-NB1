# Public, client-side values — safe to commit (protected by row level security).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side secret for the FAQ assistant. Put this in .env.local (gitignored),
# NOT in .env — .env is committed. Without it the assistant still answers from
# the built-in FAQ, it just can't handle free-form phrasing.
ANTHROPIC_API_KEY=sk-ant-your-key
